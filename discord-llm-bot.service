[Unit]
Description=Discord to OpenRouter LLM bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mjxu
WorkingDirectory=/home/mjxu/home_server
EnvironmentFile=/home/mjxu/home_server/.env
ExecStart=/home/mjxu/home_server/venv/bin/python3 /home/mjxu/home_server/bot.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
