# Copy to .env and fill in. The real .env is gitignored and never committed.
#
#   cp .env.example .env && chmod 600 .env
#
# Loaded two ways: python-dotenv at import (running by hand) and
# EnvironmentFile= in discord-llm-bot.service (under systemd). Everything not
# listed here has a working default in bot/config.py or voice/config.py.

# ---------------------------------------------------------------------------
# Required - the process refuses to start without these
# ---------------------------------------------------------------------------
DISCORD_BOT_TOKEN=paste-your-discord-bot-token-here
OPENROUTER_API_KEY=paste-your-openrouter-key-here

# Required only if you run the voice listener (voice/). Both processes read
# VOICE_SERVER_SECRET and it must match on each side - it authenticates the
# listener device to the webhook, it is not a per-user secret.
VOICE_SERVER_SECRET=generate-a-long-random-string
GROQ_API_KEY=paste-your-groq-key-here

# ---------------------------------------------------------------------------
# MACHINE-SPECIFIC - these are the ones to revisit when moving hosts
# ---------------------------------------------------------------------------
# Absolute paths on the new machine. CLAUDE_CODE_BINARY must be absolute:
# systemd's PATH does not include ~/.local/bin, where the CLI installs.
CLAUDE_CODE_WORKDIR=/home/youruser/home_server
CLAUDE_CODE_BINARY=/home/youruser/.local/bin/claude

# Must match the tailnet hostname of the machine actually running this, AND be
# registered as an authorized redirect URI in the Google Cloud console.
# Calendar linking fails with redirect_uri_mismatch until both agree.
GOOGLE_REDIRECT_URI=http://your-host.your-tailnet.ts.net/calendar/oauth/callback

# IANA name, not an abbreviation (`timedatectl list-timezones`). Interprets
# "tonight", "tomorrow at 3pm" in reminders.
TIMEZONE=America/Indiana/Indianapolis

# ---------------------------------------------------------------------------
# Identity and access
# ---------------------------------------------------------------------------
# Discord user id. Grants !code/!deploy, and is the fixed identity every voice
# command runs as. Unset means no owner - the Administrator role still works.
CLAUDE_CODE_OWNER_ID=
# Roles to create in Discord > Server Settings > Roles.
ADMIN_ROLE_NAME=Administrator
HOUSEHOLD_ROLE_NAME=Home Resident
# Only needed if the bot is in more than one server (DMs have no guild).
DISCORD_GUILD_ID=
# Mirrors every !deploy summary into one channel on top of wherever it ran.
PATCH_NOTES_CHANNEL_ID=

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# Any slug from https://openrouter.ai/models. Must support tool calling or the
# reminder/list/calendar tools silently stop working.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Not optional in practice: some providers treat an unset max_tokens as the
# whole context window for the completion, so every call 400s.
OPENROUTER_MAX_TOKENS=2048
# Route only to Zero Data Retention providers.
OPENROUTER_ZDR=0
HISTORY_TURNS=6

# ---------------------------------------------------------------------------
# Serving a path from your own hardware
# ---------------------------------------------------------------------------
# Anything speaking the OpenAI-compatible /chat/completions shape works here —
# llama.cpp, Ollama, vLLM — so a box on the tailnet can serve either path.
# Leave these unset to send everything to OpenRouter.
#
# Moderation is the better path to move first: it runs on every ordinary
# message, needs no tool calling (what small models are worst at), and is the
# one where keeping household chat off a third party actually matters. The main
# chat path is heavily tool-driven, so move it only once you've seen your local
# model handle tool calls reliably.
#
# Whenever a base points somewhere other than OpenRouter, the call falls back
# to OpenRouter if that endpoint doesn't answer — so a PC that sleeps on idle
# costs you a few cents, not a dropped reply or a silently disabled classifier.
# Set the matching _API_KEY too, so the OpenRouter key isn't handed to a local
# server, and the matching _MODEL, since a local slug is not one OpenRouter
# accepts (the fallback swaps back to OPENROUTER_MODEL automatically).
# MODERATION_API_BASE=http://your-pc.your-tailnet.ts.net:11434/v1
# MODERATION_API_KEY=local-placeholder
# MODERATION_MODEL=qwen2.5:7b
#
# LLM_API_BASE=http://your-pc.your-tailnet.ts.net:11434/v1
# LLM_API_KEY=local-placeholder
# LLM_MODEL=qwen2.5:14b

# ---------------------------------------------------------------------------
# Smart plugs (tools/kasa.py) - one shared household account
# ---------------------------------------------------------------------------
KASA_USERNAME=
KASA_PASSWORD=
# 1 restricts plug control to admins instead of everyone with the household role.
KASA_OWNER_ONLY=0

# ---------------------------------------------------------------------------
# Deprecated
# ---------------------------------------------------------------------------
# Superseded by per-user secrets on profiles.json. users.seed_geofence_from_env()
# copies anything still here onto profiles at startup; once the log says it
# seeded, delete this line.
# GEOFENCE_USERS=secret1:discord_id1,secret2:discord_id2
