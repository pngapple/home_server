.env
venv/
__pycache__/
reminders.json
client_secret.json
calendar_tokens.json
llm_metrics.json
deploy_notify.json
moderation.json
geofence_state.json

# Per-user identity + settings (bot/users.py). Holds geofence webhook
# secrets, so it's written 0600 and must never be committed.
profiles.json

# Metrics database (bot/db.py). WAL mode creates the -wal/-shm sidecars
# alongside it; committing any of them causes trouble.
llm_metrics.db
llm_metrics.db-wal
llm_metrics.db-shm
cigarettes.json
todos.json
groceries.json

# What the bot has learned about each person (bot/lessons.py) — their own
# stated preferences, so it's their data, not repo content.
lessons.json

# transient files from jsonstore.write()
*.json.tmp

# Voice commands (voice/) — its own venv, plus two personal, uncommitted
# assets: your enrolled voiceprint and the trained "jian yang" wake-word
# model (see voice/wakeword/train.md for why the model isn't checked in).
voice/venv/
voice/enrollment.npy
voice/wakeword/*.onnx
voice/wakeword/*.tflite
