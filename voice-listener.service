[Unit]
Description=Voice command listener (wake word + speech-to-text)
After=network-online.target discord-llm-bot.service
Wants=network-online.target
Requires=discord-llm-bot.service

[Service]
Type=simple
User=mjxu
WorkingDirectory=/home/mjxu/home_server
EnvironmentFile=/home/mjxu/home_server/.env
ExecStart=/home/mjxu/home_server/voice/venv/bin/python3 -m voice.listen
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
